{
  "name": "goodwater-recipes",
  "version": "1.0.0",
  "description": "Application sécurisée de gestion de recettes, menus et listes de courses",
  "main": "app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "check": "node --check app.js && node --check public/script.js && node --check public/registration-action.js",
    "test": "mocha test/**/*.test.js --timeout 10000",
    "test:api": "mocha test/api.test.js test/frontend.test.js --timeout 10000",
    "test:security": "mocha test/security.test.js --timeout 10000"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  },
  "overrides": {
    "diff": "^8.0.3",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.5"
  }
}
